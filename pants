#!/usr/bin/env bash
# Pants launcher script (bash/WSL/Git Bash)
# Auto-downloads and runs the appropriate Pants version from pants.toml

set -euo pipefail

PANTS_VERSION="${PANTS_VERSION:-$(grep -E '^\s*pants_version\s*=' pants.toml | sed -E 's/.*"([^"]+)".*/\1/')}"

# Download Pants if not already cached
PANTS_BOOTSTRAP="${PANTS_BOOTSTRAP:-${HOME}/.cache/pants/setup}"
PANTS_BINARY="${PANTS_BOOTSTRAP}/pants-${PANTS_VERSION}"

if [[ ! -x "${PANTS_BINARY}" ]]; then
  mkdir -p "${PANTS_BOOTSTRAP}"
  curl -fsSL "https://github.com/pantsbuild/scie-pants/releases/download/v${PANTS_VERSION}/scie-pants-linux-x86_64" -o "${PANTS_BINARY}"
  chmod +x "${PANTS_BINARY}"
fi

# Execute Pants with all arguments
exec "${PANTS_BINARY}" "$@"
